# Legend
legend: {
  near: bottom-center
  grid-columns: 4
  grid-gap: 8
  style.fill: "#ffffff"
  style.stroke: "#e5e7eb"
  style.border-radius: 8
  
  operational: Operational {style.fill: "#10b981"; style.font-color: "#ffffff"; style.border-radius: 4}
  implemented: Implemented {style.fill: "#3b82f6"; style.font-color: "#ffffff"; style.border-radius: 4}
  in_progress: In Progress {style.fill: "#f59e0b"; style.font-color: "#000000"; style.border-radius: 4}
  planned: Planned {style.fill: "#9ca3af"; style.font-color: "#000000"; style.border-radius: 4}
}
