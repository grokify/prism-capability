{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/prism-capability/schema/capability-stack.schema.json",
  "$defs": {
    "Capability": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "layerId": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "targetDate": {
          "type": "string"
        },
        "implementedAt": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "tooling": {
          "items": {
            "$ref": "#/$defs/Tool"
          },
          "type": "array"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enables": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "frameworkMappings": {
          "items": {
            "$ref": "#/$defs/FrameworkMapping"
          },
          "type": "array"
        },
        "prismRef": {
          "$ref": "#/$defs/PRISMRef"
        },
        "marketRef": {
          "$ref": "#/$defs/MarketRef"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name",
        "layerId"
      ]
    },
    "Category": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "color": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "FrameworkMapping": {
      "properties": {
        "framework": {
          "type": "string"
        },
        "controls": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "framework",
        "controls"
      ]
    },
    "GapContribution": {
      "properties": {
        "capabilityId": {
          "type": "string"
        },
        "segmentId": {
          "type": "string"
        },
        "contribution": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "capabilityId"
      ]
    },
    "Layer": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "phase": {
          "type": "string"
        },
        "nistCsfFunction": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "LevelCriteria": {
      "properties": {
        "M1": {
          "type": "string"
        },
        "M2": {
          "type": "string"
        },
        "M3": {
          "type": "string"
        },
        "M4": {
          "type": "string"
        },
        "M5": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MarketIntegration": {
      "properties": {
        "analysisRef": {
          "type": "string"
        },
        "defaultMarket": {
          "type": "string"
        },
        "focusSegments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MarketRef": {
      "properties": {
        "marketId": {
          "type": "string"
        },
        "capabilityIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "segments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "impact": {
          "type": "string"
        },
        "gapContribution": {
          "items": {
            "$ref": "#/$defs/GapContribution"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Metadata": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "version"
      ]
    },
    "PRISMIntegration": {
      "properties": {
        "modelRef": {
          "type": "string"
        },
        "stateRef": {
          "type": "string"
        },
        "planRef": {
          "type": "string"
        },
        "defaultDomain": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PRISMRef": {
      "properties": {
        "domainId": {
          "type": "string"
        },
        "sliIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "levelCriteria": {
          "$ref": "#/$defs/LevelCriteria"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Tool": {
      "properties": {
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "type": "array"
    },
    "categories": {
      "items": {
        "$ref": "#/$defs/Category"
      },
      "type": "array"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "type": "array"
    },
    "foundational": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "type": "array"
    },
    "prismIntegration": {
      "$ref": "#/$defs/PRISMIntegration"
    },
    "marketIntegration": {
      "$ref": "#/$defs/MarketIntegration"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "metadata",
    "layers",
    "capabilities"
  ],
  "title": "Capability Stack Specification",
  "description": "A specification for defining capability stacks with layers, capabilities, and PRISM maturity integration"
}